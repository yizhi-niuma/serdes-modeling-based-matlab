classdef (StrictDefaults) Channel < matlab.System

    properties (Nontunable)
        %load snp
        load_snp_en = 0;
        SnP_file_name;
        %Sample interval (s)
        %   The discrete fixed-step simulation sample interval.
        dt {mustBePositive(dt), mustBeFinite(dt), mustBeNonNan(dt)}= 1e-12;
        
        %Target frequency (Hz)
        %   The frequency at which the channel insertion loss equals the
        %   desired channel power loss.
        TargetFrequency  {mustBePositive(TargetFrequency), mustBeFinite(TargetFrequency), mustBeNonNan(TargetFrequency)}= 10e9;
        
        %Channel power loss (dB)
        %   The desired channel power loss
        Loss {mustBeNumeric(Loss), mustBeReal(Loss),mustBeFinite(Loss), mustBeNonNan(Loss)}= 8;
        
        %Differential impedance (Ohms)
        %   The differential impedance (Ohms) of the lossy transmission line model.
        Zc {mustBePositive(Zc), mustBeFinite(Zc), mustBeNonNan(Zc)}= 100;
        
        %Tx R (Ohms)
        %   The single ended transmitter resister strength (Ohms).
        TxR {mustBePositive(TxR), mustBeFinite(TxR), mustBeNonNan(TxR)}= 50;
        
        %Tx C (F)
        %   The single ended transmitter parasitic capacitance (Farads).
        TxC  {mustBeNonnegative(TxC), mustBeFinite(TxC), mustBeNonNan(TxC)}= 1e-12;
        
        %Rx R (Ohms)
        %   The single ended receiver termination resistor strength (Ohms).
        RxR {mustBePositive(RxR), mustBeFinite(RxR), mustBeNonNan(RxR)}= 50;
        
        %Rx C (F)
        %   The single ended receiver parasitic capacitance (Farads).
        RxC {mustBeNonnegative(RxC), mustBeFinite(RxC), mustBeNonNan(RxC)}= 1e-12;
        
        %Rise time (s)
        %   The 20/80% risetime (seconds) of the transmitter into a 50 Ohm
        %   reference load.
        RiseTime {mustBePositive(RiseTime), mustBeFinite(RiseTime), mustBeNonNan(RiseTime)}= 10e-12;
        
        %Voltage swing ideal (V)
        %   The open circuit voltage swing (Volts) of the transmitter.
        VoltageSwingIdeal {mustBePositive(VoltageSwingIdeal), mustBeFinite(VoltageSwingIdeal), mustBeNonNan(VoltageSwingIdeal)}= 1;
        EnableCrosstalk (1, 1) logical = false;
        %Crosstalk Specification
        % 'CEI-28G-SR', 'CEI-25G-LR', 'CEI-28G-VSR', '100GBASE-CR4' and
        % 'Custom'
        CrosstalkSpecification = 'CEI-28G-SR';
        %Baud rate (1/SymbolTime)
        fb = 14e9;
        
        %Far end crosstalk integrated crosstalk noise (V)
        FEXTICN = 15e-3;
        
        %Far end aggressor amplitude factor (Vpp)
        Aft = 1.200;
        
        %Far end aggressor rise time (s)
        Tft = 9.6e-12;
        
        %Near end crosstalk integrated crosstalk noise (V)
        NEXTICN = 10e-3;
        
        %Near end aggressor amplitude factor (Vpp)
        Ant = 1.200;
        
        %Near end aggressor rise time (s)
        Tnt = 9.6e-12;
    end
    
    properties(Constant, Hidden)
        CrosstalkSpecificationSet = matlab.system.StringSet( { ...
            'CEI-28G-SR', ...
            'CEI-25G-LR', ...
            'CEI-28G-VSR', ...
            '100GBASE-CR4', ...
            'Custom'} );
    end
    properties (SetAccess=protected)
        impulse     %Impulse Response
        s21         %Insertion Loss
        dF = 100e6; %Frequency step. Default 100MHz
        s11
        s22
        f
        FEXT
        NEXT
    end
    properties (SetAccess=protected , Hidden)
        privBuffer
        privIsUpToDate = false;
        privImpulse
        TLLength
        
        privBufferFEXT
        privBufferNEXT
        privhFEXT = 1;
        privhNEXT = 1;
        
        %Private crosstalk properties
        privfb
        privFEXTICN
        privAft
        privTft
        privNEXTICN
        privAnt
        privTnt

        privTLDCR = 0; %Transmission line only DC resistance
    end
    properties(Hidden)
        idealTermination = false;
    end
    
    % Pre-computed constants
    properties(Hidden, Constant)
        a0 = 1e-4; %DC loss
        a1 = 4.114e-4; %loss proportional to sqrt(f)
        a2 = 2.547e-4; %loss proportional to f
        tau =  6.191e-3; %Delay parameter
        Z_0 = 50; %Single Ended Reference Impedance
    end
    
    methods
        % Constructor
        function obj = Channel(varargin)
            % Support name-value pair arguments when constructing object
            setProperties(obj,nargin,varargin{:})
            if
                

        end
        
        function plot(obj,varargin)
            %plot   Plot time and frequency domain responses
            %   plot(obj) displays the impulse response and frequency
            %   domain response of the serdes.ChannelLoss object obj.
            %   plot(obj, SamplesPerSymbol) displays the pulse response and
            %   frequency domain response fo the serdes.ChannelLoss object,
            %   obj, where the Symbol Time is SamplesPerSymbol*obj.dt.
            
            if ~obj.privIsUpToDate
                calcImpulse(obj)
            end
            
            if nargin==2
                doPulse = true;
                validateattributes(varargin{1},...
                    {'numeric'},...
                    {'scalar','positive','integer','finite'},...
                    '','SamplesPerSymbol');
                SamplesPerSymbol = double(varargin{1});
            else
                doPulse = false;
            end
            
            %Get impulse response
            imp = obj.impulse;
            t = obj.dt*(0:length(imp)-1);
            
            gcf; clf;
            if obj.EnableCrosstalk==true
                %Include Crosstalk in time and frequency domain plots
                if doPulse==true
                    pul = impulse2pulse(imp,SamplesPerSymbol,obj.dt);
                    
                    SymbolTime = obj.dt*SamplesPerSymbol;
                    fb2 = 1/SymbolTime;
                    
                    subplot(211),plot(t*1e9,pul)
                    xlabel('ns'),ylabel('Volts')
                    grid on
                    legend('Through','FEXT','NEXT')
                    title(sprintf('Pulse Responses: SymbolTime = %g ps',SymbolTime(1)*1e12))
                    subplot(212)
                    plot(obj.f*1e-9,serdes.utilities.db(obj.s11),...
                        obj.f*1e-9,serdes.utilities.db(obj.s21),...
                        obj.f*1e-9,serdes.utilities.db(obj.s22),...
                        obj.f*1e-9,serdes.utilities.db(obj.FEXT),...
                        obj.f*1e-9,serdes.utilities.db(obj.NEXT))
                    ax = axis;
                    axis([0 fb2*2*1e-9,ax(3:4)])
                    xlabel('GHz'),ylabel('dB')
                    legend('S_{11}','S_{21}','S_{22}','FEXT','NEXT')
                    grid on
                    title('Frequncy Domain Responses')
                else
                    subplot(211),plot(t*1e9,imp)
                    xlabel('ns'),ylabel('Volts')
                    grid on
                    legend('Through','FEXT','NEXT')
                    title('Impulse Responses')
                    subplot(212)
                    plot(obj.f*1e-9,serdes.utilities.db(obj.s11),...
                        obj.f*1e-9,serdes.utilities.db(obj.s21),...
                        obj.f*1e-9,serdes.utilities.db(obj.s22),...
                        obj.f*1e-9,serdes.utilities.db(obj.FEXT),...
                        obj.f*1e-9,serdes.utilities.db(obj.NEXT))
                    xlabel('GHz'),ylabel('dB')
                    legend('S_{11}','S_{21}','S_{22}','FEXT','NEXT')
                    grid on
                    title('Frequncy Domain Responses')
                end
            else
                
                if doPulse==true
                    pul = impulse2pulse(imp,SamplesPerSymbol,obj.dt);
                    
                    SymbolTime = obj.dt*SamplesPerSymbol;
                    fb2 = 1/SymbolTime;
                    
                    subplot(211),plot(t*1e9,pul)
                    xlabel('ns'),ylabel('Volts')
                    grid on
                    legend('Through')
                    title(sprintf('Pulse Response: SymbolTime = %g ps',SymbolTime(1)*1e12))
                    subplot(212)
                    plot(obj.f*1e-9,serdes.utilities.db(obj.s11),...
                        obj.f*1e-9,serdes.utilities.db(obj.s21),...
                        obj.f*1e-9,serdes.utilities.db(obj.s22))
                    ax = axis;
                    axis([0 fb2*2*1e-9,ax(3:4)])
                    xlabel('GHz'),ylabel('dB')
                    legend('S_{11}','S_{21}','S_{22}')
                    grid on
                    title('Frequncy Domain Responses')
                    
                else
                    subplot(211),plot(t*1e9,imp)
                    xlabel('ns'),ylabel('Volts')
                    grid on
                    legend('Through')
                    title('Time Domain Response')
                    subplot(212),
                    plot(obj.f*1e-9,serdes.utilities.db(obj.s11),...
                        obj.f*1e-9,serdes.utilities.db(obj.s21),...
                        obj.f*1e-9,serdes.utilities.db(obj.s22))
                    xlabel('GHz'),ylabel('dB')
                    legend('S_{11}','S_{21}','S_{22}')
                    grid on
                    title('Frequncy Domain Responses')
                end
            end
        end
        
        function set.dt(obj,val)
            validateattributes(val,...
                {'numeric'},...
                {'scalar','finite','real','positive'},...
                '','dt');
            isUpdated = compareToOldValue(obj, 'dt', val);
            obj.dt = (val);
            if isUpdated
                %Only set not up to date flag if property changes value.
                notUpToDate(obj);
            end
        end
        function set.TargetFrequency(obj,val)
            validateattributes(val,...
                {'numeric'},...
                {'scalar','finite','real','positive'},...
                '','TargetFrequency');
            isUpdated = compareToOldValue(obj, 'TargetFrequency', val);
            obj.TargetFrequency = double(val);
            if isUpdated
                %Only set not up to date flag if property changes value.
                notUpToDate(obj);
            end
        end
        function set.Loss(obj,val)
            validateattributes(val,...
                {'numeric'},...
                {'scalar','finite','real'},...
                '','Loss');
            
            %Loss must be 0 or greater than minLoss
            minLoss = 1;
            coder.internal.errorIf(~(val==0 || val>=minLoss),...
                'serdes:serdessystem:LossValueRange',...
                sprintf('%g',minLoss));
            
            isUpdated = compareToOldValue(obj, 'Loss', val);
            obj.Loss = double(val);
            if isUpdated
                %Only set not up to date flag if property changes value.
                notUpToDate(obj);
            end
        end
